# HubSpot App Marketplace & OAuth 2.0 Configuration
HUBSPOT_CLIENT_ID=your_hubspot_app_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_app_client_secret
HUBSPOT_REDIRECT_URI=https://your-app-domain.com/oauth/callback

# Legacy Private App Token (Fallback for single-tenant internal use)
HUBSPOT_TOKEN=your_hubspot_private_app_token_here

# Cloud LLM API Keys (Google Gemini Flash & optional Grok xAI)
GEMINI_API_KEY=your_gemini_api_key_here
GROK_API_KEY=your_grok_api_key_here

# LLM Enrichment Settings
ENRICHMENT_ENABLED=False
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash

# RevOps Lead Cleaner Safety Flags
DRY_RUN=True
